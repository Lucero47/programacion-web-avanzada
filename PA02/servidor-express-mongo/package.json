{
  "name": "nexotech-catalogo",
  "version": "1.0.0",
  "description": "NexoTech PA3: catálogo electrónico con autenticación y paneles Angular y React",
  "main": "backend/src/server.js",
  "scripts": {
    "setup": "npm install && npm --prefix frontend install && npm --prefix panel-react install",
    "build": "npm run build:frontend && npm run build:panel",
    "build:frontend": "npm --prefix frontend run build",
    "build:panel": "npm --prefix panel-react run build",
    "start": "npm run build && node backend/src/server.js",
    "start:server": "node backend/src/server.js",
    "dev": "npm run build && nodemon --watch backend/src backend/src/server.js",
    "api:dev": "nodemon --watch backend/src backend/src/server.js",
    "frontend:dev": "npm --prefix frontend start",
    "panel:dev": "npm --prefix panel-react run dev",
    "seed": "node backend/scripts/seed.js",
    "test": "node --test tests/security.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
